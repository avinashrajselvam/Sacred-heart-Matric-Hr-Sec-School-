<!-- Student Dashboard -->
<div class="page-header">
  <div>
    <h1 class="page-title">Student Dashboard</h1>
    <p class="page-subtitle">Welcome back, <%= student.first_name %> <%= student.last_name %> (<%= student.admission_no %>)</p>
  </div>
</div>

<!-- Overview Stats -->
<div class="stats-grid">
  <div class="stat-card blue">
    <div class="stat-header">
      <div><div class="stat-value"><%= student.class_name || '—' %></div><div class="stat-label">Class & Section</div></div>
      <div class="stat-icon">🏛️</div>
    </div>
    <div class="stat-change">Section <%= student.section_name || '—' %></div>
  </div>

  <div class="stat-card green">
    <div class="stat-header">
      <div><div class="stat-value"><%= percentage %>%</div><div class="stat-label">Attendance Record</div></div>
      <div class="stat-icon">📅</div>
    </div>
    <div class="stat-change up"><%= attSummary.present %> days present this month</div>
  </div>

  <div class="stat-card amber">
    <div class="stat-header">
      <div><div class="stat-value"><%= formatCurrency(totalPaid) %></div><div class="stat-label">Total Fees Paid</div></div>
      <div class="stat-icon">💰</div>
    </div>
    <div class="stat-change">Total Structure: <%= formatCurrency(totalFee) %></div>
  </div>

  <div class="stat-card <%= balance > 0 ? 'red' : 'green' %>">
    <div class="stat-header">
      <div><div class="stat-value"><%= formatCurrency(balance) %></div><div class="stat-label">Pending Dues</div></div>
      <div class="stat-icon"><%= balance > 0 ? '⚠️' : '✅' %></div>
    </div>
    <a href="/student/fees" style="font-size:12px;color:<%= balance > 0 ? '#ef4444' : '#22c55e' %>">View fee details →</a>
  </div>
</div>

<div class="grid-2">
  <!-- Recent Announcements -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">📢 School Announcements</div>
      <a href="/student/announcements" class="btn btn-ghost btn-sm">View all</a>
    </div>
    <div class="card-body">
      <% if (announcements.length) { %>
      <div style="display:flex;flex-direction:column;gap:14px">
        <% announcements.forEach(a => { %>
        <div style="padding-bottom:12px;border-bottom:1px solid #f1f5f9">
          <div style="font-weight:600;font-size:14px;color:#1e3a5f"><%= a.title %></div>
          <div style="font-size:12.5px;color:#475569;margin-top:4px"><%= a.content %></div>
          <div style="font-size:11px;color:#94a3b8;margin-top:4px"><%= formatDate(a.created_at) %></div>
        </div>
        <% }) %>
      </div>
      <% } else { %>
      <div class="empty-state"><div class="empty-icon">📢</div><p>No announcements at this time.</p></div>
      <% } %>
    </div>
  </div>

  <!-- Recent Payments -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">🧾 Recent Fee Receipts</div>
      <a href="/student/fees" class="btn btn-ghost btn-sm">View all</a>
    </div>
    <div class="card-body" style="padding:0">
      <% if (recentPayments.length) { %>
      <table class="data-table">
        <thead><tr><th>Receipt No</th><th>Amount</th><th>Date</th><th>Action</th></tr></thead>
        <tbody>
        <% recentPayments.forEach(p => { %>
        <tr>
          <td><span class="badge badge-secondary"><%= p.receipt_number %></span></td>
          <td><strong style="color:#22c55e"><%= formatCurrency(p.amount_paid) %></strong></td>
          <td style="font-size:12px"><%= formatDate(p.payment_date) %></td>
          <td><a href="/fees/receipt/<%= p.receipt_number %>" target="_blank" class="btn btn-ghost btn-sm">📄 View</a></td>
        </tr>
        <% }) %>
        </tbody>
      </table>
      <% } else { %>
      <div class="empty-state"><div class="empty-icon">🧾</div><p>No payment records found.</p></div>
      <% } %>
    </div>
  </div>
</div>
