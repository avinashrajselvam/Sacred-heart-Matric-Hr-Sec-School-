<!-- Student Announcements -->
<div class="page-header">
  <div>
    <h1 class="page-title">School Announcements</h1>
    <p class="page-subtitle">Official updates and notices from Sacred Heart Matric Hr Sec School</p>
  </div>
</div>

<% if (announcements.length) { %>
<div style="display:flex;flex-direction:column;gap:16px">
<% announcements.forEach(a => { %>
<div class="card">
  <div class="card-header">
    <div>
      <div class="card-title" style="font-size:17px;color:#1e3a5f"><%= a.title %></div>
      <div style="font-size:12px;color:#94a3b8;margin-top:2px">Posted on <%= formatDate(a.created_at) %></div>
    </div>
    <span class="badge badge-info">📢 Announcement</span>
  </div>
  <div class="card-body">
    <p style="font-size:14.5px;line-height:1.7;color:#334155"><%= a.content %></p>
  </div>
</div>
<% }) %>
</div>
<% } else { %>
<div class="empty-state">
  <div class="empty-icon">📢</div>
  <h3>No Announcements</h3>
  <p>There are no active announcements at this time.</p>
</div>
<% } %>
