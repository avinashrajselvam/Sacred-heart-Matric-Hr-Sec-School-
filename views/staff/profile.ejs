<!-- Staff Profile -->
<div class="page-header">
  <div>
    <h1 class="page-title">My Profile</h1>
    <p class="page-subtitle">Staff & Teacher Account Details</p>
  </div>
</div>

<div class="grid-12">
  <!-- Left card: Summary -->
  <div class="card">
    <div class="card-body" style="text-align:center;padding:32px 20px">
      <div style="width:90px;height:90px;border-radius:50%;background:#1e3a5f;color:#d4a843;display:flex;align-items:center;justify-content:center;font-size:36px;font-weight:700;margin:0 auto 16px;box-shadow:0 6px 20px rgba(30,58,95,0.25)">
        <%= staffInfo.first_name[0] %><%= staffInfo.last_name[0] %>
      </div>
      <h2 style="font-size:20px;font-weight:700;color:#1a2332"><%= staffInfo.first_name %> <%= staffInfo.last_name %></h2>
      <p style="font-size:13px;color:#64748b;margin-top:4px"><%= staffInfo.designation || 'Staff Member' %></p>
      <div style="margin-top:14px">
        <span class="badge badge-info" style="font-size:13px;padding:6px 14px">Employee ID: <%= staffInfo.employee_id %></span>
      </div>
    </div>
  </div>

  <!-- Right card: Information -->
  <div class="card">
    <div class="card-header"><div class="card-title">📋 Staff Information</div></div>
    <div class="card-body">
      <div class="info-list">
        <div class="info-item">
          <span class="info-icon">🏛️</span>
          <div><div class="info-label">Assigned Class & Section</div><div class="info-value"><%= staffInfo.class_name || 'Not Assigned' %><% if(staffInfo.section_name) { %> — Section <%= staffInfo.section_name %><% } %></div></div>
        </div>
        <div class="info-item">
          <span class="info-icon">📚</span>
          <div><div class="info-label">Department</div><div class="info-value"><%= staffInfo.department || '—' %></div></div>
        </div>
        <div class="info-item">
          <span class="info-icon">📞</span>
          <div><div class="info-label">Phone Number</div><div class="info-value"><%= staffInfo.phone || '—' %></div></div>
        </div>
        <div class="info-item">
          <span class="info-icon">✉️</span>
          <div><div class="info-label">Email Address</div><div class="info-value"><%= staffInfo.email || '—' %></div></div>
        </div>
        <div class="info-item">
          <span class="info-icon">📅</span>
          <div><div class="info-label">Date of Joining</div><div class="info-value"><%= formatDate(staffInfo.date_of_joining) %></div></div>
        </div>
      </div>
    </div>
  </div>
</div>
