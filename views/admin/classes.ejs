<!-- Classes & Sections Management -->
<div class="page-header">
  <div>
    <h1 class="page-title">Classes & Sections</h1>
    <p class="page-subtitle">Manage school classes and sections</p>
  </div>
</div>

<div class="grid-2">
  <!-- Classes -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">Classes (<%= classes.length %>)</div>
      <button class="btn btn-primary btn-sm" onclick="document.getElementById('addClassModal').classList.add('show')">+ Add Class</button>
    </div>
    <div class="card-body" style="padding:0">
      <table class="data-table">
        <thead><tr><th>Class Name</th><th>Students</th><th>Action</th></tr></thead>
        <tbody>
        <% classes.forEach(c => { %>
        <tr>
          <td><strong><%= c.name %></strong></td>
          <td><span class="badge badge-info"><%= c.student_count %></span></td>
          <td>
            <form method="POST" action="/admin/classes/<%= c.id %>/delete"
                  data-confirm="Delete class '<%= c.name %>'? This cannot be undone.">
              <button type="submit" class="btn btn-ghost btn-sm">🗑️</button>
            </form>
          </td>
        </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Sections -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">Sections (<%= sections.length %>)</div>
      <button class="btn btn-primary btn-sm" onclick="document.getElementById('addSectionModal').classList.add('show')">+ Add Section</button>
    </div>
    <div class="card-body" style="padding:0;max-height:420px;overflow-y:auto">
      <table class="data-table">
        <thead><tr><th>Class</th><th>Section</th><th>Action</th></tr></thead>
        <tbody>
        <% sections.forEach(s => { %>
        <tr>
          <td><%= s.class_name %></td>
          <td><strong>Section <%= s.name %></strong></td>
          <td>
            <form method="POST" action="/admin/sections/<%= s.id %>/delete"
                  data-confirm="Delete this section?">
              <button type="submit" class="btn btn-ghost btn-sm">🗑️</button>
            </form>
          </td>
        </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Class Modal -->
<div class="modal-overlay" id="addClassModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Add New Class</span>
      <button class="modal-close" onclick="document.getElementById('addClassModal').classList.remove('show')">✕</button>
    </div>
    <form method="POST" action="/admin/classes">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Class Name <span class="required">*</span></label>
          <input type="text" name="name" class="form-control" placeholder="e.g., Class 11" required/>
        </div>
        <div class="form-group">
          <label class="form-label">Display Order</label>
          <input type="number" name="display_order" class="form-control" placeholder="e.g., 15" value="<%= classes.length + 1 %>"/>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('addClassModal').classList.remove('show')">Cancel</button>
        <button type="submit" class="btn btn-primary">Add Class</button>
      </div>
    </form>
  </div>
</div>

<!-- Add Section Modal -->
<div class="modal-overlay" id="addSectionModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Add New Section</span>
      <button class="modal-close" onclick="document.getElementById('addSectionModal').classList.remove('show')">✕</button>
    </div>
    <form method="POST" action="/admin/sections">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Class <span class="required">*</span></label>
          <select name="class_id" class="form-control" required>
            <option value="">-- Select Class --</option>
            <% classes.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Section Name <span class="required">*</span></label>
          <input type="text" name="name" class="form-control" placeholder="e.g., D" required/>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('addSectionModal').classList.remove('show')">Cancel</button>
        <button type="submit" class="btn btn-primary">Add Section</button>
      </div>
    </form>
  </div>
</div>
