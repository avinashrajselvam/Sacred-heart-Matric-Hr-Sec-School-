<!-- Add/Edit Student Form -->
<div class="page-header">
  <div>
    <h1 class="page-title"><%= student ? 'Edit Student' : 'Add New Student' %></h1>
    <p class="page-subtitle"><%= student ? 'Update student information' : 'Register a new student in the system' %></p>
  </div>
  <a href="/admin/students" class="btn btn-outline">← Back to Students</a>
</div>

<% if (error) { %>
<div class="alert alert-error"><%= error %></div>
<% } %>

<form method="POST" action="<%= student ? '/admin/students/' + student.id + '/edit' : '/admin/students' %>" id="studentForm">

  <!-- Personal Information -->
  <div class="form-section">
    <div class="form-section-title">👤 Personal Information</div>
    <div class="form-row cols-3">
      <div class="form-group">
        <label class="form-label" for="admission_no">Admission No. <span class="required">*</span></label>
        <input type="text" id="admission_no" name="admission_no" class="form-control" required
               value="<%= student ? student.admission_no : nextAdmission %>"
               <%= student ? 'readonly' : '' %>/>
      </div>
      <div class="form-group">
        <label class="form-label" for="first_name">First Name <span class="required">*</span></label>
        <input type="text" id="first_name" name="first_name" class="form-control" required
               value="<%= student ? student.first_name : '' %>"/>
      </div>
      <div class="form-group">
        <label class="form-label" for="last_name">Last Name <span class="required">*</span></label>
        <input type="text" id="last_name" name="last_name" class="form-control" required
               value="<%= student ? student.last_name : '' %>"/>
      </div>
    </div>
    <div class="form-row cols-3">
      <div class="form-group">
        <label class="form-label" for="date_of_birth">Date of Birth</label>
        <input type="date" id="date_of_birth" name="date_of_birth" class="form-control"
               value="<%= student && student.date_of_birth ? student.date_of_birth : '' %>"/>
      </div>
      <div class="form-group">
        <label class="form-label" for="gender">Gender</label>
        <select id="gender" name="gender" class="form-control">
          <option value="">-- Select --</option>
          <option value="Male"   <%= student && student.gender==='Male'   ? 'selected' : '' %>>Male</option>
          <option value="Female" <%= student && student.gender==='Female' ? 'selected' : '' %>>Female</option>
          <option value="Other"  <%= student && student.gender==='Other'  ? 'selected' : '' %>>Other</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="blood_group">Blood Group</label>
        <select id="blood_group" name="blood_group" class="form-control">
          <option value="">-- Select --</option>
          <% ['A+','A-','B+','B-','O+','O-','AB+','AB-'].forEach(bg => { %>
          <option value="<%= bg %>" <%= student && student.blood_group===bg ? 'selected' : '' %>><%= bg %></option>
          <% }) %>
        </select>
      </div>
    </div>
  </div>

  <!-- Class Information -->
  <div class="form-section">
    <div class="form-section-title">🏛️ Class & Admission Details</div>
    <div class="form-row cols-3">
      <div class="form-group">
        <label class="form-label" for="class_id">Class <span class="required">*</span></label>
        <select id="class_id" name="class_id" class="form-control">
          <option value="">-- Select Class --</option>
          <% classes.forEach(c => { %>
          <option value="<%= c.id %>" <%= student && student.class_id==c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="section_id">Section</label>
        <select id="section_id" name="section_id" class="form-control">
          <option value="">-- Select Section --</option>
          <% sections.forEach(s => { %>
          <option value="<%= s.id %>" <%= student && student.section_id==s.id ? 'selected' : '' %>>Section <%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="admission_date">Admission Date</label>
        <input type="date" id="admission_date" name="admission_date" class="form-control"
               value="<%= student && student.admission_date ? student.admission_date : new Date().toISOString().split('T')[0] %>"/>
      </div>
    </div>
    <% if (student) { %>
    <div class="form-group">
      <label class="form-label" for="is_active">Status</label>
      <select id="is_active" name="is_active" class="form-control" style="max-width:200px">
        <option value="1" <%= student.is_active ? 'selected' : '' %>>Active</option>
        <option value="0" <%= !student.is_active ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>
    <% } %>
  </div>

  <!-- Parent/Guardian Information -->
  <div class="form-section">
    <div class="form-section-title">👨‍👩‍👧 Parent / Guardian Information</div>
    <div class="form-row cols-3">
      <div class="form-group">
        <label class="form-label" for="parent_name">Parent / Guardian Name</label>
        <input type="text" id="parent_name" name="parent_name" class="form-control"
               value="<%= student ? student.parent_name || '' : '' %>"/>
      </div>
      <div class="form-group">
        <label class="form-label" for="parent_phone">Phone Number</label>
        <input type="tel" id="parent_phone" name="parent_phone" class="form-control"
               value="<%= student ? student.parent_phone || '' : '' %>"/>
      </div>
      <div class="form-group">
        <label class="form-label" for="parent_email">Email Address</label>
        <input type="email" id="parent_email" name="parent_email" class="form-control"
               value="<%= student ? student.parent_email || '' : '' %>"/>
      </div>
    </div>
    <div class="form-group">
      <label class="form-label" for="address">Address</label>
      <textarea id="address" name="address" class="form-control" rows="2"
                style="resize:vertical"><%= student ? student.address || '' : '' %></textarea>
    </div>
  </div>

  <div style="display:flex;gap:12px">
    <button type="submit" class="btn btn-primary btn-lg">
      <%= student ? '💾 Update Student' : '✅ Add Student' %>
    </button>
    <a href="/admin/students" class="btn btn-outline btn-lg">Cancel</a>
  </div>

</form>
