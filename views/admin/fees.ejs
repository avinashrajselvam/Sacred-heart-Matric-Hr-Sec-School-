<!-- Fee Structure Management -->
<div class="page-header">
  <div>
    <h1 class="page-title">Fee Structure</h1>
    <p class="page-subtitle">Academic Year: <%= academicYear %></p>
  </div>
  <button class="btn btn-primary" onclick="document.getElementById('addFeeModal').classList.add('show')">+ Add Fee</button>
</div>

<!-- Fee Structure Table -->
<div class="card">
  <div class="card-body" style="padding:0">
    <% if (feeStructures.length) { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Class</th><th>Fee Name</th><th>Amount</th><th>Academic Year</th><th>Due Date</th><th>Action</th></tr></thead>
        <tbody>
        <% feeStructures.forEach(f => { %>
        <tr>
          <td><span class="badge badge-secondary"><%= f.class_name %></span></td>
          <td><strong><%= f.fee_name %></strong></td>
          <td><strong style="color:#1e3a5f"><%= formatCurrency(f.amount) %></strong></td>
          <td><span class="badge badge-info"><%= f.academic_year %></span></td>
          <td><%= f.due_date ? formatDate(f.due_date) : '—' %></td>
          <td>
            <form method="POST" action="/admin/fee-structure/<%= f.id %>/delete"
                  data-confirm="Delete this fee structure?">
              <button type="submit" class="btn btn-ghost btn-sm">🗑️ Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">📋</div>
      <h3>No Fee Structures</h3>
      <p>Add fee structures for each class.</p>
    </div>
    <% } %>
  </div>
</div>

<!-- Add Fee Modal -->
<div class="modal-overlay" id="addFeeModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Add Fee Structure</span>
      <button class="modal-close" onclick="document.getElementById('addFeeModal').classList.remove('show')">✕</button>
    </div>
    <form method="POST" action="/admin/fee-structure">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Class <span class="required">*</span></label>
          <select name="class_id" class="form-control" required>
            <option value="">-- Select Class --</option>
            <% classes.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Fee Name <span class="required">*</span></label>
          <input type="text" name="fee_name" class="form-control" required placeholder="e.g., Tuition Fee, Exam Fee"/>
        </div>
        <div class="form-row cols-2">
          <div class="form-group">
            <label class="form-label">Amount (₹) <span class="required">*</span></label>
            <input type="number" name="amount" class="form-control" required min="0" step="0.01"/>
          </div>
          <div class="form-group">
            <label class="form-label">Due Date</label>
            <input type="date" name="due_date" class="form-control"/>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Academic Year</label>
          <input type="text" name="academic_year" class="form-control" value="<%= academicYear %>"/>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('addFeeModal').classList.remove('show')">Cancel</button>
        <button type="submit" class="btn btn-primary">Add Fee</button>
      </div>
    </form>
  </div>
</div>
