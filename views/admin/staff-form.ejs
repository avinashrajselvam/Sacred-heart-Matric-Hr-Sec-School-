<!-- Add/Edit Staff Form -->
<div class="page-header">
  <div>
    <h1 class="page-title"><%= staffMember ? 'Edit Staff' : 'Add New Staff' %></h1>
    <p class="page-subtitle"><%= staffMember ? 'Update staff information' : 'Register a new staff member' %></p>
  </div>
  <a href="/admin/staff" class="btn btn-outline">← Back to Staff</a>
</div>

<% if (error) { %>
<div class="alert alert-error"><%= error %></div>
<% } %>

<form method="POST" action="<%= staffMember ? '/admin/staff/' + staffMember.id + '/edit' : '/admin/staff' %>">

  <div class="form-section">
    <div class="form-section-title">👤 Staff Information</div>
    <div class="form-row cols-3">
      <div class="form-group">
        <label class="form-label">Employee ID <span class="required">*</span></label>
        <input type="text" name="employee_id" class="form-control" required
               value="<%= staffMember ? staffMember.employee_id : nextId %>"
               <%= staffMember ? 'readonly' : '' %>/>
      </div>
      <div class="form-group">
        <label class="form-label">First Name <span class="required">*</span></label>
        <input type="text" name="first_name" class="form-control" required
               value="<%= staffMember ? staffMember.first_name : '' %>"/>
      </div>
      <div class="form-group">
        <label class="form-label">Last Name <span class="required">*</span></label>
        <input type="text" name="last_name" class="form-control" required
               value="<%= staffMember ? staffMember.last_name : '' %>"/>
      </div>
    </div>
    <div class="form-row cols-2">
      <div class="form-group">
        <label class="form-label">Phone</label>
        <input type="tel" name="phone" class="form-control"
               value="<%= staffMember ? staffMember.phone || '' : '' %>"/>
      </div>
      <div class="form-group">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control"
               value="<%= staffMember ? staffMember.email || '' : '' %>"/>
      </div>
    </div>
    <div class="form-row cols-3">
      <div class="form-group">
        <label class="form-label">Designation</label>
        <input type="text" name="designation" class="form-control"
               placeholder="e.g., Class Teacher"
               value="<%= staffMember ? staffMember.designation || '' : '' %>"/>
      </div>
      <div class="form-group">
        <label class="form-label">Department</label>
        <input type="text" name="department" class="form-control"
               placeholder="e.g., Science"
               value="<%= staffMember ? staffMember.department || '' : '' %>"/>
      </div>
      <div class="form-group">
        <label class="form-label">Date of Joining</label>
        <input type="date" name="date_of_joining" class="form-control"
               value="<%= staffMember ? staffMember.date_of_joining || '' : '' %>"/>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-title">🏛️ Class Assignment</div>
    <div class="form-row cols-2">
      <div class="form-group">
        <label class="form-label">Assigned Class</label>
        <select id="class_id" name="assigned_class_id" class="form-control">
          <option value="">-- Not Assigned --</option>
          <% classes.forEach(c => { %>
          <option value="<%= c.id %>" <%= staffMember && staffMember.assigned_class_id==c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Assigned Section</label>
        <select id="section_id" name="assigned_section_id" class="form-control">
          <option value="">-- Not Assigned --</option>
          <% sections.forEach(s => { %>
          <option value="<%= s.id %>" <%= staffMember && staffMember.assigned_section_id==s.id ? 'selected' : '' %>>Section <%= s.name %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <% if (staffMember) { %>
    <div class="form-group">
      <label class="form-label">Status</label>
      <select name="is_active" class="form-control" style="max-width:200px">
        <option value="1" <%= staffMember.is_active ? 'selected' : '' %>>Active</option>
        <option value="0" <%= !staffMember.is_active ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>
    <% } %>
  </div>

  <div style="display:flex;gap:12px">
    <button type="submit" class="btn btn-primary btn-lg">
      <%= staffMember ? '💾 Update Staff' : '✅ Add Staff' %>
    </button>
    <a href="/admin/staff" class="btn btn-outline btn-lg">Cancel</a>
  </div>
</form>
